# ===============================================================================
# ModernWMS & PartDB Unified Suite Environment Configuration
# ===============================================================================

# Docker Container Names
MODERNWMS_CONTAINER=modernwms
PARTDB_CONTAINER=partdb

# Database Paths (Host)
PARTDB_DB_PATH=/root/docker-server/partdb/db/app.db
MODERNWMS_DB_PATH=/app/wms.db
MODERNWMS_BACKUP_DIR=/root/backups/modernwms
AUDIT_LOG_FILE=/root/tui_audit.log

# Sync Service Ports & Domain URLs
PORT=8082
HOST_IP=127.0.0.1
SYNC_ADMIN_USER=admin
SYNC_ADMIN_PASS=admin123
PARTDB_URL=https://partdb.kierancollins.xyz/en/
MODERNWMS_URL=https://modernwms.kierancollins.xyz/
OVERVIEW_URL=https://overview.kierancollins.xyz/
GRAFANA_URL=https://grafana.kierancollins.xyz/

# Multi-Channel Gateway Ports
GATEWAY_PORT=7681
TTYD_PORT=7682
LISTEN_PORTS=23,2323
